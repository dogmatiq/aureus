test "fixtures" {
    test "test" {
        assertion {
            fixture "testdata/fixtures/test.fixture.@foo=bar.txt" {
                lang = "txt"
                attributes {
                    "foo" = "bar"
                }
                data = "FIXTURE 1\n"
            }
            fixture "testdata/fixtures/test.fixture.@foo=baz.txt" {
                lang = "txt"
                attributes {
                    "foo" = "baz"
                }
                data = "FIXTURE 2\n"
            }
            input "testdata/fixtures/test.input.txt" {
                lang = "txt"
                data = "INPUT\n"
            }
            output "testdata/fixtures/test.output.txt" {
                lang = "txt"
                data = "OUTPUT\n"
            }
        }
    }
}
